{
  "name": "preparehaematology",
  "version": "1.0.0",
  "description": "Prepare Haematology - FRCPath Part 1 revision Progressive Web App",
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build_web_content.py",
    "check": "python3 scripts/build_web_content.py --check",
