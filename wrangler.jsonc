{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preparehaematology",
  "main": "./worker.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
